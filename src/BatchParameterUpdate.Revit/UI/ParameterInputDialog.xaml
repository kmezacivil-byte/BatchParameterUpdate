<Window x:Class="BatchParameterUpdate.Revit.UI.ParameterInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Parameter Update"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Parameter name" Margin="0,0,0,4" />
        <TextBox Grid.Row="1" Name="ParameterNameTextBox"
                  Text="{Binding ParameterName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Text="New value" Margin="0,12,0,4" />
        <TextBox Grid.Row="3" Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="OK" Width="80"
                    Command="{Binding OkCommand}" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
